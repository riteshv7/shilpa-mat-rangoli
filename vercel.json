{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/((?!images/|assets/|favicon.svg|.*\\..*).*)",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
